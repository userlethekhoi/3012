    "No visible items were found in this folder." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không tìm thấy mục hiển thị nào trong thư mục này." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此文件夹中没有可见项目。" } } } },
    "Read-Only Device Access" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Truy cập thiết bị chỉ đọc" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只读设备访问" } } } },
    "Read-only app-container access is available." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền truy cập container ứng dụng chỉ đọc đã khả dụng." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只读应用容器访问可用。" } } } },
    "Scan App Containers" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quét container ứng dụng" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描应用容器" } } } },
    "Scanning Containers…" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang quét container…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在扫描容器…" } } } },
    "error.containerDiscoveryFailed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "App containers could not be discovered. Check the build identity and session log." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể tìm container ứng dụng. Hãy kiểm tra build identity và nhật ký phiên." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法发现应用容器。请检查构建身份和会话日志。" } } } },
    "error.pathOutsideLease" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The requested path is outside the active container lease." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đường dẫn yêu cầu nằm ngoài container lease đang hoạt động." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请求的路径位于活动容器租约之外。" } } } },
