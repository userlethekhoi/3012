{
  "sourceLanguage" : "en",
  "strings" : {
    "3012 currently writes only inside folders explicitly selected through Files." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "3012 hiện chỉ ghi bên trong thư mục được người dùng chọn rõ ràng qua Files." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "3012 目前仅写入用户通过“文件”明确选择的文件夹。" } }
      }
    },
    "Access" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền truy cập" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "访问" } }
      }
    },
    "Adjust text and controls across 3012." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Điều chỉnh chữ và control trên toàn bộ 3012." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "调整整个 3012 中的文字和控件大小。" } }
      }
    },
