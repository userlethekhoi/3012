    "Checking direct app-container access." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang kiểm tra quyền truy cập trực tiếp container ứng dụng." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查应用容器直接访问权限。" } }
      }
    },
    "Compatibility checks passed, but the container provider could not be activated. Check the signing identity and session log." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kiểm tra tương thích đã đạt nhưng không thể kích hoạt provider container. Hãy kiểm tra định danh chữ ký và nhật ký phiên." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "兼容性检查已通过，但无法激活容器提供程序。请检查签名标识和会话日志。" } }
      }
    },
    "Bundle ID" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bundle ID" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Bundle ID" } }
      }
    },
    "Copy" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Sao chép" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制" } }
      }
    },
    "Device" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thiết bị" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备" } }
      }
    },
    "Direct app-container browsing will appear only when a verified provider is available." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Duyệt trực tiếp container ứng dụng chỉ xuất hiện khi có provider đã được xác minh." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在经过验证的提供程序可用时，才会显示直接浏览应用容器的功能。" } }
      }
    },
    "Direct app-container access is not supported on this iOS build. Manual patching through Files is still available." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản dựng iOS này không hỗ trợ truy cập trực tiếp container ứng dụng. Patch thủ công qua Files vẫn khả dụng." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 iOS 构建不支持直接访问应用容器。仍可通过“文件”手动修补。" } }
