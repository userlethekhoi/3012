    "Standard Files access is unavailable on this device." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền Files tiêu chuẩn không khả dụng trên thiết bị này." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备无法使用标准文件访问。" } } } },
    "Target Folder" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thư mục đích" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标文件夹" } } } },
    "Telegram" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Telegram" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Telegram" } } } },
    "This preview is not signature verification. A package can be applied only after a production public key is configured and every SHA-256 digest is valid." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phần xem trước không phải xác minh chữ ký. Package chỉ được áp dụng sau khi cấu hình public key production và mọi SHA-256 đều hợp lệ." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此预览并非签名验证。只有配置生产公钥且所有 SHA-256 摘要有效后，才能应用软件包。" } } } },
    "Unknown Error" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Lỗi không xác định" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未知错误" } } } },
    "Updates" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cập nhật" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新" } } } },
    "Verified installed patches will appear here with backup and restore status." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Patch đã xác minh và cài đặt sẽ xuất hiện tại đây cùng trạng thái backup và khôi phục." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已验证并安装的补丁将在此显示，并附带备份和恢复状态。" } } } },
    "Verify and Patch" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kiểm tra và patch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "验证并修补" } } } },
    "Verifying" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang xác minh" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在验证" } } } },
    "Version" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Phiên bản" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本" } } } },
    "error.backgroundTaskMissing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The background task no longer exists." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tác vụ nền không còn tồn tại." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "后台任务已不存在。" } } } },
    "error.bookmarkUnavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File or folder access could not be saved." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể lưu quyền truy cập file hoặc thư mục." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法保存文件或文件夹访问权限。" } } } },
    "error.historySaveFailed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The patch completed, but its history could not be saved: %@" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Patch đã hoàn tất nhưng không thể lưu lịch sử: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补丁已完成，但无法保存历史记录：%@" } } } },
    "error.insufficientStorage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not enough free space. About %@ is required; %@ is available." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không đủ dung lượng trống. Cần khoảng %@; hiện có %@." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可用空间不足。大约需要 %@；当前可用 %@。" } } } },
    "error.invalidRelativePath" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Invalid path: %@" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đường dẫn không hợp lệ: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "路径无效：%@" } } } },
    "error.noFiles" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No replacement files are selected." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bạn chưa chọn file thay thế." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未选择替换文件。" } } } },
    "error.packageUnreadable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This package could not be read. It may be malformed or exceed a safety limit." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể đọc package này. File có thể sai định dạng hoặc vượt giới hạn an toàn." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取此软件包。文件可能格式错误或超过安全限制。" } } } },
    "error.staleBookmark" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Access has expired. Select the file or folder again." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền truy cập đã hết hạn. Hãy chọn lại file hoặc thư mục." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "访问权限已过期。请重新选择文件或文件夹。" } } } },
    "error.targetNotSelected" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No target folder is selected." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bạn chưa chọn thư mục đích." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未选择目标文件夹。" } } } },
    "status.patchCompleted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Patch completed. A backup was saved for restore." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Patch hoàn tất. Backup đã được lưu để khôi phục." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补丁已完成。已保存用于恢复的备份。" } } } },
    "status.restoreCompleted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original files were restored." } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đã khôi phục các file gốc." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原始文件已恢复。" } } } },
    "status.restoringBackup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking and restoring the backup…" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang kiểm tra và khôi phục backup…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查并恢复备份…" } } } },
    "status.verifyingBackup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verifying and creating a backup…" } }, "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang xác minh và tạo backup…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在验证并创建备份…" } } } },
    "App Containers" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Container ứng dụng" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用容器" } } } },
    "Application containers are exposed read-only until device validation and transaction integration are complete." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Container ứng dụng chỉ được mở ở chế độ đọc cho đến khi hoàn tất kiểm thử thiết bị và tích hợp transaction." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在完成设备验证和事务集成之前，应用容器仅以只读方式公开。" } } } },
    "Container Access" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Truy cập container" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "容器访问" } } } },
    "Container browsing is read-only in this milestone." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Duyệt container chỉ đọc trong giai đoạn này." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此阶段的容器浏览为只读。" } } } },
    "Empty Folder" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thư mục trống" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空文件夹" } } } },
