    "Publisher" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhà phát hành" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发布者" } } } },
    "Queued" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang chờ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "排队中" } } } },
    "Relative path, for example Documents/file.bin" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đường dẫn tương đối, ví dụ Documents/file.bin" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "相对路径，例如 Documents/file.bin" } } } },
    "Remove File" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bỏ file" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除文件" } } } },
    "Replace Existing File" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thay file có sẵn" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "替换现有文件" } } } },
    "Restore" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复" } } } },
    "Restore Failed" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể khôi phục" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复失败" } } } },
    "Restore Original Files" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục file gốc" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复原始文件" } } } },
    "Restore Original Files?" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khôi phục file gốc?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复原始文件？" } } } },
