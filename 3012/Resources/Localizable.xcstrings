      }
    },
    "Standard Files Access" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Quyền Files tiêu chuẩn" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "标准文件访问" } }
      }
    },
    "Supported" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Được hỗ trợ" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "受支持" } }
      }
    },
    "System" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hệ thống" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统" } }
      }
    },
    "This build does not include direct app-container access. Use the Device Access IPA." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Bản dựng này không gồm quyền truy cập trực tiếp container ứng dụng. Hãy dùng IPA Device Access." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此构建不包含应用容器直接访问功能。请使用 Device Access IPA。" } }
      }
    },
    "Unavailable" : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không khả dụng" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不可用" } }
      }
    },
    "Use large local files without uploading them to a server." : {
      "localizations" : {
        "vi" : { "stringUnit" : { "state" : "translated", "value" : "Dùng file lớn trên máy mà không cần tải lên server." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用大型本地文件，无需上传到服务器。" } }
      }
    },
    "3012 does not include advertising, telemetry, or an AI runtime." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "3012 không tích hợp quảng cáo, telemetry hoặc AI runtime." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "3012 不包含广告、遥测或 AI 运行时。" } } } },
    "3012 restores only when the current file still matches the patched version, preventing newer changes from being overwritten." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "3012 chỉ khôi phục khi file hiện tại vẫn khớp bản đã patch, tránh ghi đè thay đổi mới hơn." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅当当前文件仍与已修补版本匹配时，3012 才会恢复，以免覆盖较新的更改。" } } } },
    "3012 verifies every file and creates a journal and backup before changing the target folder." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "3012 xác minh mọi file, tạo journal và backup trước khi thay đổi thư mục đích." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "3012 会在更改目标文件夹前验证每个文件，并创建日志和备份。" } } } },
    "3012 writes only inside the folder selected through Files. Choose the correct root folder so the relative paths below match exactly." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "3012 chỉ ghi trong thư mục được chọn qua Files. Hãy chọn đúng thư mục gốc để các đường dẫn tương đối bên dưới khớp chính xác." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "3012 仅写入通过“文件”选择的文件夹。请选择正确的根文件夹，使下面的相对路径完全匹配。" } } } },
    "Activity" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoạt động" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "活动" } } } },
    "Add Replacement Files" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thêm file thay thế" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加替换文件" } } } },
    "Appearance" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Giao diện" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "外观" } } } },
    "Author" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tác giả" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "作者" } } } },
    "Available" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Khả dụng" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可用" } } } },
    "BACKED UP" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "ĐÃ BACKUP" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已备份" } } } },
    "Back Up and Patch" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạo backup và patch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "备份并修补" } } } },
    "Background Downloads" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tải nền" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "后台下载" } } } },
    "Beta" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thử nghiệm" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "测试版" } } } },
    "Cancel" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hủy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "Catalog Channel" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Kênh catalog" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目录通道" } } } },
    "Catalog Trust" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xác minh catalog" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目录信任" } } } },
    "Choose a Folder to Patch" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chọn thư mục được phép patch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择要修补的文件夹" } } } },
    "Close" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đóng" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } } } },
    "Completed" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Hoàn tất" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已完成" } } } },
    "Confirm Manual Patch" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xác nhận patch thủ công" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确认手动补丁" } } } },
    "Create New File" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tạo file mới" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建新文件" } } } },
    "Dark" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tối" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "深色" } } } },
    "Delete" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xóa" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "Do not close the app or disconnect Files while patching. If a step fails, the transaction rolls back files already changed." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không đóng app hoặc ngắt kết nối Files khi đang patch. Nếu một bước thất bại, transaction sẽ rollback các file đã thay đổi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "修补时请勿关闭应用或断开“文件”。如果某一步失败，事务会回滚已更改的文件。" } } } },
    "Downloading" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Đang tải" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载" } } } },
    "Failed" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Lỗi" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "失败" } } } },
    "File Count" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Số file" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件数量" } } } },
    "Information" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thông tin" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信息" } } } },
    "Import Package" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Nhập package" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入软件包" } } } },
    "Language" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Ngôn ngữ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语言" } } } },
    "Large files are streamed in chunks. The app creates a temporary package, verifies SHA-256, backs up originals, and removes the temporary package when finished." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "File lớn được đọc theo từng khối. App tạo package tạm, xác minh SHA-256, backup file gốc và xóa package tạm khi hoàn tất." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "大文件会分块流式处理。应用会创建临时软件包、验证 SHA-256、备份原文件，并在完成后删除临时软件包。" } } } },
    "Light" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Sáng" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "浅色" } } } },
    "Local · No Server Upload" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Cục bộ · Không tải lên server" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地 · 不上传服务器" } } } },
    "Mode" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chế độ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模式" } } } },
    "No Downloads" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không có lượt tải" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无下载" } } } },
    "No Installed Patches" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa có patch đã cài" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无已安装补丁" } } } },
    "Not Configured" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Chưa cấu hình" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未配置" } } } },
    "Operation" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Thao tác" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "操作" } } } },
    "Package Import Failed" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Không thể nhập package" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "软件包导入失败" } } } },
    "Package Preview" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Xem trước package" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "软件包预览" } } } },
    "Packages being downloaded, paused, or verified will be managed here." : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Các package đang tải, tạm dừng hoặc chờ xác minh sẽ được quản lý tại đây." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载、暂停或验证的软件包将在此管理。" } } } },
    "Patch Files" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "File patch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补丁文件" } } } },
    "Patch Name" : { "localizations" : { "vi" : { "stringUnit" : { "state" : "translated", "value" : "Tên patch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补丁名称" } } } },
