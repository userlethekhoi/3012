# /etc/3012-build.env — edit, then: sudo systemctl restart 3012-build
BUILD_BIND=127.0.0.1
BUILD_PORT=8787
BUILD_IMAGE=3012-theos-builder:latest

# Builds running at the same time (each gets BUILD_MEMORY RAM and BUILD_CPUS CPUs).
BUILD_CONCURRENCY=2
BUILD_MEMORY=1g
BUILD_CPUS=1.5
BUILD_TIMEOUT_SEC=120

# Abuse protection
BUILD_MAX_QUEUE=30
BUILD_MAX_UPLOAD_MB=20
BUILD_RATE_PER_DEVICE_HOUR=20
BUILD_RATE_PER_IP_HOUR=40
BUILD_DISK_MAX_PERCENT=90

# Artifacts are deleted this many seconds after a build finishes.
BUILD_ARTIFACT_TTL_SEC=900
BUILD_DATA_DIR=/var/lib/3012-build

# Optional: stronger sandbox with gVisor (install runsc first), e.g. BUILD_RUNTIME=runsc
BUILD_RUNTIME=
