# /etc/3012-build.env — edit, then: sudo systemctl restart 3012-build
BUILD_BIND=127.0.0.1
BUILD_PORT=8787
BUILD_IMAGE=3012-theos-builder:latest

# Builds running at the same time (each gets BUILD_MEMORY RAM and BUILD_CPUS CPUs).
BUILD_CONCURRENCY=2
BUILD_MEMORY=1g
BUILD_CPUS=1.5
BUILD_TIMEOUT_SEC=180

# Overload & abuse protection
BUILD_MAX_QUEUE=30
BUILD_MAX_UPLOAD_MB=20
BUILD_MAX_PROJECT_MB=300
BUILD_MAX_PROJECT_FILES=4000
BUILD_CAS_BATCH_MB=16
BUILD_CAS_MAX_MB=4096
BUILD_WORKSPACES_MAX_MB=4096
BUILD_WORKSPACE_TTL_SEC=86400
BUILD_MIN_FREE_RAM_MB=350
# Short 60-second anti-spam burst cap (0 = disabled); over-burst waits only a few seconds.
BUILD_BURST_PER_DEVICE_MIN=15
BUILD_BURST_PER_IP_MIN=45
# Hourly build cap (0 = unlimited builds per hour, recommended with burst guard above).
BUILD_RATE_PER_DEVICE_HOUR=0
BUILD_RATE_PER_IP_HOUR=0
BUILD_DISK_MAX_PERCENT=90

# Artifacts are deleted this many seconds after a build finishes.
BUILD_ARTIFACT_TTL_SEC=900
BUILD_DATA_DIR=/var/lib/3012-build

# Optional: stronger sandbox with gVisor (install runsc first), e.g. BUILD_RUNTIME=runsc
BUILD_RUNTIME=
